# hermit serve configuration
DATABASE_URL=postgres://localhost/hermit
HERMIT_BIND=127.0.0.1:8080
HERMIT_WORKERS=2
HERMIT_WEB_DIR=web/out
HERMIT_ALLOW_LOCAL=1
# HERMIT_WORKSPACES=~/.hermit/workspaces

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./hermit-app.private-key.pem
GITHUB_WEBHOOK_SECRET=
